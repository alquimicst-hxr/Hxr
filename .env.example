# --- Telegram ---
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_ID=
# Opcional: no máximo 1 ID extra (limite total de 2 administradores, incluindo o proprietário)
ADMIN_TELEGRAM_IDS=
SUPPORT_USERNAME=
# Opcional: @canal ou https://t.me/...
SUPPORT_CHANNEL=
SUPPORT_FORWARD_TO_ADMINS=true

# --- Provedores de IA (configure só os que for usar) ---
DEFAULT_PROVIDER=openrouter
# Nenhum modelo é embutido no código: informe o identificador do modelo do provedor.
DEFAULT_MODEL=
# Provedor alternativo (opcional) e seu modelo
FALLBACK_PROVIDER=
FALLBACK_MODEL=
# Modelo específico por provedor (opcional): OPENROUTER_MODEL, GROQ_MODEL, TOGETHER_MODEL, DEEPSEEK_MODEL,
# MISTRAL_MODEL, FIREWORKS_MODEL, CEREBRAS_MODEL, XAI_MODEL, NVIDIA_MODEL, HUGGINGFACE_MODEL, INFERENCE_NET_MODEL
OPENROUTER_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
FIREWORKS_API_KEY=
CEREBRAS_API_KEY=
XAI_API_KEY=
NVIDIA_API_KEY=
HUGGINGFACE_API_KEY=
INFERENCE_NET_API_KEY=

# --- Armazenamento e logs ---
DATABASE_PATH=data/haxorgpt.db
LOG_PATH=data/logs/haxorgpt.log
LOG_LEVEL=INFO

# --- Planos e cotas ---
FREE_MESSAGE_LIMIT=10
STANDARD_QUOTA=500
PRO_QUOTA=2000
ULTRA_QUOTA=10000
PLAN_PERIOD_DAYS=30
# Modelos por plano (opcional; valem para o provedor principal)
FREE_PLAN_MODEL=
STANDARD_MODEL=
PRO_MODEL=
ULTRA_MODEL=

# --- Grupos ---
GROUP_MIN_MEMBERS=500
GROUP_PREMIUM_FEATURE_ENABLED=false
GROUP_PREMIUM_PLAN=standard
GROUPS_ENABLED_BY_DEFAULT=false

# --- Limites de API, histórico e frequência ---
API_TIMEOUT_SECONDS=60
API_MAX_RETRIES=2
API_BACKOFF_BASE_SECONDS=1
API_BACKOFF_MAX_SECONDS=20
MAX_OUTPUT_TOKENS=1024
HISTORY_MAX_MESSAGES=20
HISTORY_MAX_CHARS=12000
HISTORY_RETENTION_DAYS=30
MAX_INPUT_CHARS=4000
RATE_LIMIT_MESSAGES=5
RATE_LIMIT_WINDOW_SECONDS=30
# Personalidade padrão (opcional; vazio = neutra)
DEFAULT_PERSONALITY=
